rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      match /vehicles/{vehicleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /maintenance/{maintenanceId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /fuel/{fuelId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /fines/{fineId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /ipva/{ipvaId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
